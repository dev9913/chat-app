PORT=4000
NODE_ENV=production
DATABASE_URL="postgresql://chatly_user:STRONG_PROD_PASSWORD@db:5432/chatly_prod?schema=public&connection_limit=20"
CORS_ORIGIN="https://chatly.yourdomain.com"
BACKEND_URL="https://api.chatly.yourdomain.com"

JWT_ACCESS_SECRET="<generate-with-openssl-rand-hex-64>"
JWT_REFRESH_SECRET="<generate-with-openssl-rand-hex-64>"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"


MAX_FILE_SIZE=26214400
UPLOAD_DESTINATION="./uploads"

# Email Settings (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="abcdefghijklmnop"
SMTP_FROM="Chatly <your-email@gmail.com>"
